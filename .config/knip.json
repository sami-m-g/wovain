{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "commitlint": {
    "config": [".config/commitlint.config.ts"]
  },
  "workspaces": {
    "apps/fumadocs": {
      "ignoreDependencies": ["tailwindcss", "@tailwindcss/postcss"],
      "ignore": [
        "src/components/ai/**",
        "src/components/codeblock.tsx",
        "src/components/ui/**"
      ]
    },
    "apps/web": {
      "ignoreDependencies": ["tailwindcss", "@tailwindcss/postcss"]
    },
    "packages/widgets": {
      "entry": ["src/{trends,design,product,campaign}.tsx", "src/styles.css"],
      "ignoreDependencies": ["tailwindcss"]
    }
  },
  "ignore": [".agents/**", "infra/**"]
}
