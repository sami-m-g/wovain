{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"]
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "better-auth": {
      "type": "http",
      "url": "https://mcp.better-auth.com/mcp"
    },
    "mastra": {
      "command": "npx",
      "args": ["-y", "@mastra/mcp-docs-server"]
    },
    "fal": {
      "type": "http",
      "url": "https://mcp.fal.ai/mcp-relay"
    },
    "fourthwall": {
      "type": "http",
      "url": "https://mcp.fourthwall.com/app"
    },
    "qloo-docs": {
      "type": "http",
      "url": "https://docs.qloo.com/mcp"
    },
    "qloo": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@qloo/qloo-harness", "mcp"],
      "env": { "QLOO_API_KEY": "${QLOO_API_KEY}" }
    },
    "tavily": {
      "type": "http",
      "url": "https://mcp.tavily.com/mcp"
    },
    "inngest-dev": {
      "type": "http",
      "url": "http://127.0.0.1:8288/mcp"
    },
    "pulumi": {
      "type": "http",
      "url": "https://mcp.ai.pulumi.com/mcp"
    }
  }
}
