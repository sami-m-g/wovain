{
  "name": "wovain",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "spec:validate": "openspec validate --all --strict",
    "test": "turbo run test",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @wovain/db --",
    "db:studio": "turbo run db:studio -F @wovain/db --",
    "db:generate": "turbo run db:generate -F @wovain/db --",
    "db:migrate": "turbo run db:migrate -F @wovain/db --",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/fumadocs/ && varlock codegen --path ./packages/db/",
    "postinstall": "pnpm run env:generate",
    "auth:generate": "pnpm --filter web run auth:generate",
    "polar:seed": "pnpm --filter web run polar:seed",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "knip": "knip --config .config/knip.json",
    "infra:install": "pulumi install --cwd infra",
    "infra:check-types": "pnpm --dir infra run check-types",
    "infra:bootstrap:preview": "node infra/scripts/pulumi.ts preview infra/bootstrap",
    "infra:bootstrap:up": "node infra/scripts/pulumi.ts up infra/bootstrap",
    "infra:preview": "node infra/scripts/pulumi.ts preview infra",
    "infra:test": "pnpm --dir infra run test",
    "infra:up": "node infra/scripts/pulumi.ts up infra"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@fission-ai/openspec": "catalog:",
    "@types/node": "catalog:",
    "@wovain/config": "workspace:*",
    "knip": "^6.43.0",
    "lefthook": "latest",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.86.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "ultracite": "8.0.1",
    "varlock": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.3.4"
}
