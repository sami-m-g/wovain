{
  "name": "wovain",
  "version": "0.24.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @wovain/widgets build",
    "check": "ultracite check && pnpm skills:check",
    "skills:check": "node scripts/skills-check.ts",
    "fix": "ultracite fix",
    "typecheck": "tsc -b --noEmit",
    "typecheck:6": "tsc6 -b --noEmit",
    "test": "pnpm --filter @wovain/server --filter @wovain/ops test",
    "test:integration": "pnpm --filter @wovain/server test:integration",
    "test:live": "pnpm --filter @wovain/server test:live",
    "test:e2e": "pnpm build && pnpm --filter @wovain/server test:e2e && pnpm --filter @wovain/widgets proof",
    "demo": "pnpm --filter @wovain/widgets demo",
    "prepare": "lefthook install && skills add challengepost/learn-ai-basics --skill '*' -y -a claude-code --copy && skills experimental_sync -y -a claude-code --copy",
    "knip": "knip --config .config/knip.json",
    "arch": "depcruise --config .config/dependency-cruiser.json apps packages",
    "dupes": "jscpd --config .config/jscpd.json",
    "storybook": "pnpm --filter @wovain/widgets storybook",
    "test:stories": "pnpm --filter @wovain/widgets test:stories",
    "widgets:watch": "pnpm --filter @wovain/widgets build --watch",
    "dev": "pnpm --filter @wovain/server dev",
    "start": "node apps/server/src/index.ts",
    "infra:install": "pulumi install --cwd infra",
    "infra:preview": "pulumi preview --cwd infra --stack prod",
    "infra:up": "pulumi up --cwd infra --stack prod"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/gitlab": "13.3.3",
    "@types/node": "24.19.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "dependency-cruiser": "18.7.0",
    "jscpd": "5.4.2",
    "knip": "6.42.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-plugin-react-doctor": "^0.9.16",
    "oxlint-tsgolint": "^7.0.2004",
    "semantic-release": "25.0.9",
    "skills": "1.7.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "ultracite": "8.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
