{
  "name": "wovain",
  "version": "0.12.2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter @wovain/web build",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "tsc -b --noEmit",
    "typecheck:6": "tsc6 -b --noEmit",
    "test": "bun test",
    "mock": "WOVAIN_MOCK=1 bun run dev",
    "prepare": "bun run scripts/prepare.ts",
    "knip": "knip",
    "skills:restore": "skills experimental_install -y",
    "storybook": "bun run --filter @wovain/cards storybook",
    "test:stories": "bun run --filter @wovain/cards test:stories",
    "cards:watch": "bun run apps/cards/build.ts --watch",
    "dev": "bun run --filter @wovain/web dev",
    "db:generate": "bun run --filter @wovain/db generate",
    "db:migrate": "bun run --filter @wovain/db migrate"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@neon/config": "1.8.7",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/gitlab": "13.3.3",
    "@types/bun": "^1.4.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "knip": "6.42.0",
    "lefthook": "2.2.2",
    "markdown-it": "15.0.2",
    "node-html-parser": "9.0.4",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-plugin-react-doctor": "^0.9.16",
    "oxlint-tsgolint": "^7.0.2004",
    "semantic-release": "25.0.9",
    "skills": "1.7.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "ultracite": "8.0.1",
    "zod": "4.6.7"
  }
}
