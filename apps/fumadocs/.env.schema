# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Nebius Token Factory key for the docs AI chat (Nemotron)
# Optional: without it the AI chat endpoint responds 503
# @optional
NEBIUS_API_KEY=

# Nebius Token Factory's OpenAI-compatible endpoint
# @public @type=url
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# The AI chat's model: Nemotron 3.5 Lightning ($0.06 in, $0.24 out per 1M
# tokens). Deployed, Pulumi sets it per environment (`docsChatModel` in
# infra/Pulumi.<stack>.yaml); this value is for local work. @dynamic, so the
# image reads the deployed value at runtime instead of inlining this one.
# @public @dynamic
DOCS_CHAT_MODEL=nvidia/Nemotron-3_5-Lightning

# The chat model's reasoning effort, sent as reasoning_effort. Lightning
# reasons for about 300 tokens before a short answer, so with a small token
# cap anything but "none" can cut the answer off. Set like DOCS_CHAT_MODEL
# (`docsChatReasoningEffort` in Pulumi config).
# @public @dynamic @type=enum(none, low, medium, high)
DOCS_CHAT_REASONING_EFFORT=none

# The most tokens one answer may use, reasoning included
# (`docsChatMaxOutputTokens` in Pulumi config).
# @public @dynamic @type=number(min=1, isInt=true)
DOCS_CHAT_MAX_OUTPUT_TOKENS=400

# PostHog project token and host for the chat's $ai_generation events; empty turns tracing off
# @optional @public
POSTHOG_KEY=phc_mME2j3q9bo7cE2Kn2tiZbQqZAfMmHR2HmmeWKzuMxZNo

# @public @type=url
POSTHOG_HOST=https://us.i.posthog.com

# Public origin of the docs site, used for canonical and hreflang URLs
# @public @type=url
SITE_URL=http://localhost:4000
