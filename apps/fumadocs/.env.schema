# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# OpenRouter API key for the docs AI chat
# Optional: without it the AI chat endpoint responds 503
# @optional @type=string(startsWith=sk-or-)
OPENROUTER_API_KEY=

# OpenRouter model ID for the docs AI chat; defaults to the free-models router
# @public
OPENROUTER_MODEL=openrouter/free

# Public origin of the docs site, used for canonical and hreflang URLs
# @public @type=url
SITE_URL=http://localhost:4000
