{
  "extends": "@wovain/config/tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "references": [
    {
      "path": "./tsconfig.vendor.json"
    }
  ],
  "exclude": [
    ".vendor-types",
    "src/components/ai",
    "src/components/codeblock.tsx",
    "src/components/tabs",
    "src/components/ui",
    "src/lib/cn.ts",
    "src/lib/merge-refs.ts"
  ]
}
