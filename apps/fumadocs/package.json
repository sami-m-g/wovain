    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@varlock/nextjs-integration": "catalog:",
    "@wovain/ui": "workspace:*",
    "ai": "^7.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "flexsearch": "^0.8.212",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
