# @defaultRequired=true
# @defaultSensitive=false
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# The wovain server the app talks to: its oRPC API (/api/rpc) and Better
# Auth (/api/auth). Inlined at build time by @varlock/expo-integration's
# Babel plugin; EAS builds set it per profile (eas.json). Locally, the web
# app's dev server on the host's LAN address, so a phone can reach it.
# @type=url
EXPO_PUBLIC_API_URL=https://next.wovain.com

# PostHog Error Tracking, the one place wovain's errors are watched: the
# environment's own PostHog project's public token (the same project as the
# website the build talks to), safe in client code. EAS builds set it per
# environment as an EAS environment variable, like EAS_PROJECT_ID. Empty
# turns reporting off (local development).
# @required=false @sensitive=false
EXPO_PUBLIC_POSTHOG_KEY=

# PostHog's ingestion host (EU projects: https://eu.i.posthog.com).
# @type=url
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
