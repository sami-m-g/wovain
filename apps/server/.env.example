# wovain server keys for `bun run dev`. Copy to apps/server/.env and fill in;
# empty values count as unset. On Vercel, set them in the project's settings.
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_PIXEL_ID=
SERPAPI_KEY=
ETSY_API_KEY=
MARKER_API_TOKEN=
FAL_KEY=
# Optional: a second fal key with the Billing preset, so wovain can report what fal actually charged
FAL_BILLING_KEY=

# Sign-in (WorkOS AuthKit). The AuthKit domain (e.g. https://<name>.authkit.app)
# signs merchants in and issues /mcp's tokens; the API key reads each caller's
# email for the allowlist. Both come from the WorkOS dashboard. Set
# WOVAIN_SITE_URL only to override the site URL, e.g. a tunnel.
WORKOS_AUTHKIT_DOMAIN=
WORKOS_API_KEY=
WOVAIN_SITE_URL=
# Comma-separated emails allowed to sign in; empty lets nobody in. Everyone
# signed in acts through the Meta and fal keys above until step 4.
WOVAIN_ALLOWED_EMAILS=

# Storage: Neon Postgres and the private Vercel Blob store (no offline mode).
# On Vercel the Neon and Blob integrations set these; for local work against
# Neon, use the dev branch's pooled URL, never production's.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Monitor: traces to GitLab Observability over OTLP/HTTP. The endpoint (and
# the auth header, as key=value) come from the GitLab group → Observe →
# Observability configuration. Unset means no telemetry is sent.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
