{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hono",
  "bunVersion": "1.4.x",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "functions": {
    "dist/index.js": {
      "includeFiles": "../widgets/dist/*.html"
    }
  },
  "installCommand": "bun install --ignore-scripts"
}
