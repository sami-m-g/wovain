{
  "name": "@wovain/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun run --cwd ../widgets build && bun build src/index.ts --target bun --format esm --outdir dist --external hono",
    "generate": "bun --bun drizzle-kit generate",
    "migrate": "bun run src/db/migrate.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.7",
    "@better-auth/core": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@better-auth/utils": "0.4.2",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@vercel/blob": "2.8.1",
    "@vercel/otel": "2.1.3",
    "@wovain/shared": "workspace:*",
    "better-auth": "1.7.7",
    "better-call": "1.4.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/bun": "1.4.3",
    "drizzle-kit": "0.31.11"
  }
}
