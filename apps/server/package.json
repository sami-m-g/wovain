{
  "name": "@wovain/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "firebase emulators:exec --only firestore,storage --project demo-wovain \"node --env-file-if-exists=.env --watch src/index.ts\"",
