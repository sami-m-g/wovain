{
  "extends": "@wovain/config/tsconfig.base.json",
  "references": [
    {
      "path": "../../packages/api"
    },
    {
      "path": "../../packages/ui"
    }
  ],
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowArbitraryExtensions": true,
    "exactOptionalPropertyTypes": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
