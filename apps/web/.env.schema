# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Which deployment this is: production (wovain.com), next (next.wovain.com,
# where main deploys) or development (dev.wovain.com, a laptop). Pulumi sets
# it on each Cloud Run service (infra/); feature flags, analytics and traces
# read it instead of guessing from the host. @dynamic: one image can run in
# more than one environment, so it is read at runtime, never inlined.
# @sensitive=false @dynamic @type=enum(production, next, development)
APP_ENV=development

# The site's public origin: OAuth metadata and connect links publish it.
# @sensitive=false @type=url
BETTER_AUTH_URL=

# Per-environment settings. None has a default: deployed, Pulumi sets each
# one from the stack's config (infra/index.ts, infra/Pulumi.<stack>.yaml) on
# Cloud Run and in the image build (the WEB_BUILD_ENV Actions variable);
# locally, set them in .env.local (production's values are in
# infra/Pulumi.prod.yaml). @dynamic: read at runtime, so one image serves any
# environment; pages prerendered at build show the build's values.

# The public MCP endpoint ChatGPT connects to (<BETTER_AUTH_URL>/api/mcp
# locally); access tokens are bound to it. The site shows it for ChatGPT
# setup.
# @sensitive=false @dynamic @type=url
MCP_URL=

# The docs site, linked from the website's nav and footer.
# @sensitive=false @dynamic @type=url
DOCS_URL=

# The address the site's "Contact" link and the terms name.
# @sensitive=false @dynamic @type=email
SUPPORT_EMAIL=

# The address the privacy policy gives for account deletion.
# @sensitive=false @dynamic @type=email
PRIVACY_EMAIL=

# The OAuth scope wovain asks Meta's MCP server for (space separated).
# @sensitive=false @dynamic
META_MCP_SCOPE=

# The providers' MCP servers wovain connects merchants through.
# @sensitive=false @dynamic @type=url
FAL_MCP_URL=

# @sensitive=false @dynamic @type=url
FOURTHWALL_MCP_URL=

# @sensitive=false @dynamic @type=url
META_MCP_URL=

# The hosts wovain's ChatGPT widgets may load images from (their CSP), comma
# separated: fal's art and Fourthwall's mockups.
# @sensitive=false @dynamic
MCP_WIDGET_RESOURCE_DOMAINS=

# The Fourthwall blank a catalog search that stays empty falls back to.
# @sensitive=false @dynamic
FOURTHWALL_DEFAULT_PRODUCT_ID=

# wovain's catalog, JSON validated with zod (packages/billing/src/catalog.ts):
# plans, the credit pack, credit costs, promos, the promo price per credit,
# the code redemption limit, the runs a merchant has going at once and the
# designs a run draws.
# @sensitive=false @dynamic
BILLING_CATALOG=

# The pricing rules, JSON validated with zod (packages/core/src/pricing.ts):
# card fees, sales tax, shipping, refund reserve, minimum profit and margin,
# and the base cost of a typical tee when the catalog doesn't say.
# @sensitive=false @dynamic
PRICING_RULES=

# Nemotron's list price on Nebius, USD per million tokens, for PostHog's LLM
# cost.
# @sensitive=false @dynamic @type=number(min=0)
NEMOTRON_INPUT_PRICE=

# @sensitive=false @dynamic @type=number(min=0)
NEMOTRON_OUTPUT_PRICE=

# The guardrails' block thresholds, 0 to 1 (packages/core/src/agents.ts).
# @sensitive=false @dynamic @type=number(min=0, max=1)
GUARDRAIL_INJECTION_THRESHOLD=

# @sensitive=false @dynamic @type=number(min=0, max=1)
GUARDRAIL_MODERATION_THRESHOLD=

# @sensitive=false @dynamic @type=number(min=0, max=1)
GUARDRAIL_PII_THRESHOLD=

# @type=string(minLength=1)
DATABASE_URL=

# Seals merchants' Fourthwall and Meta tokens at rest (AES-256-GCM): 32
# random bytes, base64 encoded (`openssl rand -base64 32`).
# @type=string(minLength=44)
TOKEN_ENCRYPTION_KEY=

# Google sign-in ("Continue with Google"): a Web application OAuth client whose
# authorized redirect URIs include <BETTER_AUTH_URL>/api/auth/callback/google.
# Without both values the button is hidden.
# Public but @dynamic: varlock inlines non-sensitive values at build time, and
# the image is built without Google's credentials, so this one is read at runtime.
# @required=false @sensitive=false @dynamic
GOOGLE_CLIENT_ID=

# @required=false
GOOGLE_CLIENT_SECRET=

# Expo push access token (expo.dev, account settings → access tokens), sent
# with each push to the mobile app. Needed only once the Expo project turns
# on enhanced push security; without it, pushes go out unauthenticated.
# @required=false
EXPO_ACCESS_TOKEN=

# Resend sends wovain's emails (verification, password reset, run updates).
# Without a key, each email is logged instead of sent.
# @required=false
RESEND_API_KEY=

# The sender of every email. Its domain must be one Resend has verified:
# wovain.com, whose DKIM (resend._domainkey) and bounce domain (send.) are in
# Cloud DNS (infra/domains.ts). Per environment, like the settings above.
# @sensitive=false @dynamic
EMAIL_FROM=

# The seller flow's providers. Each key is optional: a missing one fails only
# the step that needs it, with a NOT_CONFIGURED error naming the variable.

# Nebius Token Factory key: Nemotron writes briefs and ad copy, judges designs
# and makes autopilot's calls.
# @required=false
NEBIUS_API_KEY=

# @sensitive=false @type=url
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# The Nebius model wovain's agents, scorers and guardrails call (Nemotron 3.5
# Super VL). Deployed, Pulumi sets it per environment (`nemotronModel` in
# infra/Pulumi.<stack>.yaml); this value is for local work. @dynamic, so the
# image reads the deployed value at runtime instead of inlining this one.
# @sensitive=false @dynamic
NEMOTRON_MODEL=nvidia/Nemotron-3.5-Super-VL

# The Nebius vision model the design judge reads the drawn art with. Set like
# NEMOTRON_MODEL (`nemotronVisionModel` in Pulumi config).
# @sensitive=false @dynamic
NEMOTRON_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL

# The Nemotron model per job (packages/core/src/model-router.ts): fast for
# guardrails, scorers and classifiers; default for briefs and ad copy;
# reasoning for long plans and the judge's reasoning; vision to read images;
# safety for content and ad-policy checks. Set like NEMOTRON_MODEL
# (`nemotronModelFast`, `nemotronModelDefault`, `nemotronModelReasoning`,
# `nemotronModelVision`, `nemotronModelSafety` in Pulumi config, with a
# `-dev` or `-next` suffix per environment); these values are for local work.
# Agents use them while the model-routing flag is on (packages/core/src/agents.ts
# AGENT_ROLES): reasoning is Nemotron 3 Ultra. Token Factory serves no
# Nemotron content-safety model (checked 2026-10-28), so safety is the fast
# model and moderation runs through Mastra's ModerationProcessor on it.
# @sensitive=false @dynamic
NEMOTRON_MODEL_FAST=nvidia/Nemotron-3_5-Lightning
# @sensitive=false @dynamic
NEMOTRON_MODEL_DEFAULT=nvidia/Nemotron-3.5-Super-VL
# @sensitive=false @dynamic
NEMOTRON_MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b
# @sensitive=false @dynamic
NEMOTRON_MODEL_VISION=nvidia/Nemotron-3.5-Super-VL
# @sensitive=false @dynamic
NEMOTRON_MODEL_SAFETY=nvidia/Nemotron-3_5-Lightning

# The fal endpoint that draws the print art (GPT Image), on the merchant's own
# fal account. Set like NEMOTRON_MODEL (`falImageModel` in Pulumi config).
# @sensitive=false @dynamic
FAL_IMAGE_MODEL=openai/gpt-image-2.5/flare/text-to-image

# Tavily Research's model for idea dossiers: mini (cheaper, about a minute),
# pro (deeper) or auto (Tavily picks). Set per environment in Pulumi config
# (`tavilyResearchModel`, with a `-dev` or `-next` suffix); this value is for
# local work.
# @sensitive=false @dynamic @type=enum(mini, pro, auto)
TAVILY_RESEARCH_MODEL=mini

# wovain's own fal key (fal.ai dashboard, API keys). While the
# onboarding-wizard flag is on, designs draw on it, paid by the design's
# credits, and no merchant fal connection is needed. Without it, designs use
# the merchant's fal connection. Secret Manager `fal-key` (`fal-key-<env>`).
# @required=false
FAL_KEY=

# Qloo Taste API key for the hackathon server.
# @required=false
QLOO_API_KEY=

# @sensitive=false @type=url
QLOO_API_URL=https://hackathon.api.qloo.com

# Meta's Graph API with its version, where Qloo's audiences are matched to
# Meta interest IDs (targeting search, with META_APP_ID and META_APP_SECRET).
# @sensitive=false @type=url
META_GRAPH_URL=https://graph.facebook.com/v24.0

# Tavily search, called live on every trend research.
# @required=false
TAVILY_API_KEY=

# Agent quality (docs/adr/0002-agent-quality.md): the share of live model
# calls Mastra's scorers judge (each judged call costs about 10 more
# Nemotron calls), and the guardrail processors on model inputs and outputs
# ("off" skips them, for local work only).
# @sensitive=false @type=number(min=0, max=1)
SCORER_SAMPLE_RATE=0.1

# @sensitive=false @type=enum(on, off)
GUARDRAILS=on

# Polar, wovain's own billing: plans, the credit pack and the credits meter
# (packages/billing; `pnpm polar:seed` creates them). An organization access
# token from Settings > Developers, with the products, benefits, meters,
# customers, customer_sessions, checkouts, subscriptions, events and webhooks
# scopes. Sandbox and production are separate accounts with separate tokens.
# Without it, checkout and the portal are off, and no paid step runs (credits
# only arrive from Polar).
# @required=false
POLAR_ACCESS_TOKEN=

# @sensitive=false @type=enum(sandbox, production)
POLAR_ENVIRONMENT=sandbox

# Signs Polar's webhooks to <BETTER_AUTH_URL>/api/auth/polar/webhooks. Locally,
# the secret `polar webhook listen --print-secret` prints; deployed, the
# endpoint's secret (`pnpm polar:seed` with POLAR_WEBHOOK_URL creates the
# endpoint). Without it, plans and credits aren't mirrored.
# @required=false
POLAR_WEBHOOK_SECRET=

# wovain's Meta app (Business type, Ads MCP use case), the OAuth client
# merchants connect Meta through. Its Valid OAuth Redirect URIs must include
# <BETTER_AUTH_URL>/api/connections/meta/callback. Fourthwall needs no app
# credentials: wovain identifies itself with a client metadata document.
# Public but @dynamic: varlock inlines non-sensitive values at build time, and
# the image is built without Meta's credentials, so this one is read at runtime.
# @required=false @sensitive=false @dynamic
META_APP_ID=

# @required=false
META_APP_SECRET=

# PostHog product analytics: the environment's own PostHog project's public
# token (US cloud; production's is project 687269), safe in client code. Cookieless until a visitor consents
# (instrumentation-client.ts, src/lib/consent.ts); the browser reaches PostHog through this site's /ingest rewrite. NEXT_PUBLIC_
# values are compiled into the client bundle, so the image build reads it
# (CI can override it with its own NEXT_PUBLIC_POSTHOG_KEY variable). Set it
# empty to turn analytics off. Each environment has its own PostHog project,
# so there is no default: Pulumi sets the key per Cloud Run service and per
# GitHub environment (infra/).
# @required=false @sensitive=false
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog's ingestion host (EU projects: https://eu.i.posthog.com).
# @sensitive=false @type=url
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Feature flags (packages/core/src/flags.ts): a PostHog project secret API key
# (phs_..., Project settings > Secret API keys, scope feature_flag:read). The
# server polls the flag definitions with it and evaluates them locally; it
# must never reach the browser. Without it the flag registry answers.
# @required=false
POSTHOG_SECRET_KEY=

# Durable runs (docs/adr/0001-durable-runs.md): Inngest Cloud runs each run
# step by calling /api/inngest. The event key lets the app queue runs; the
# signing key proves a call to /api/inngest came from Inngest. Without them
# a run can't start (locally, set INNGEST_DEV=1 and run the Inngest Dev
# Server: `npx inngest-cli@latest dev -u http://localhost:3000/api/inngest`).
# @required=false
INNGEST_EVENT_KEY=

# @required=false
INNGEST_SIGNING_KEY=

# The Inngest app this deployment registers as. Each environment has its
# own (Pulumi sets wovain-dev and wovain-next; production keeps wovain), next
# to its own Inngest keys, so syncing one never repoints another's app.
# @sensitive=false @dynamic
INNGEST_APP_ID=wovain

# 1 (or the Dev Server's URL) for local development only: it turns off
# signature checks, so never set it in production.
# @required=false @sensitive=false
INNGEST_DEV=
