# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# The site's public origin: OAuth metadata and connect links publish it.
# @sensitive=false @type=url
BETTER_AUTH_URL=

# The public MCP endpoint ChatGPT connects to, when it isn't
# <BETTER_AUTH_URL>/api/mcp; access tokens are bound to it. The landing page
# shows it for ChatGPT setup.
# @required=false @sensitive=false @type=url
MCP_URL=

# The docs site, linked from the website's nav and footer.
# @sensitive=false @type=url
DOCS_URL=https://docs.wovain.com

# @type=string(minLength=1)
DATABASE_URL=

# Seals merchants' Fourthwall and Meta tokens at rest (AES-256-GCM): 32
# random bytes, base64 encoded (`openssl rand -base64 32`).
# @type=string(minLength=44)
TOKEN_ENCRYPTION_KEY=

# Resend sends wovain's emails (verification, password reset, run updates).
# Without a key, each email is logged instead of sent.
# @required=false
RESEND_API_KEY=

# @sensitive=false
EMAIL_FROM=wovain <hello@wovain.com>

# The seller flow's providers. Each key is optional: a missing one fails only
# the step that needs it, with a NOT_CONFIGURED error naming the variable.

# Nebius Token Factory key: Nemotron writes briefs and ad copy, judges designs
# and makes autopilot's calls.
# @required=false
NEBIUS_API_KEY=

# @sensitive=false @type=url
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Qloo Taste API key for the hackathon server.
# @required=false
QLOO_API_KEY=

# @sensitive=false @type=url
QLOO_API_URL=https://hackathon.api.qloo.com

# Tavily search, called live on every trend research.
# @required=false
TAVILY_API_KEY=

# fal key for print art (GPT Image on fal).
# @required=false
FAL_KEY=

# Spend guard. Sign-up is open, so the paid steps above are bounded:
# allowlisted emails (comma separated) are unlimited; everyone else gets
# SPEND_RUNS_PER_DAY runs a UTC day and SPEND_IMAGES_PER_RUN images a run,
# and all of them stop once today's estimated spend passes the cap (USD).
# @required=false
WOVAIN_ALLOWED_EMAILS=

# @sensitive=false @type=number(min=0, isInt=true)
SPEND_RUNS_PER_DAY=2

# @sensitive=false @type=number(min=0, isInt=true)
SPEND_IMAGES_PER_RUN=4

# @sensitive=false @type=number(min=0)
SPEND_DAILY_CAP_USD=5

# wovain's Meta app (Business type, Ads MCP use case), the OAuth client
# merchants connect Meta through. Its Valid OAuth Redirect URIs must include
# <BETTER_AUTH_URL>/api/connections/meta/callback. Fourthwall needs no app
# credentials: wovain identifies itself with a client metadata document.
# @required=false @sensitive=false
META_APP_ID=

# @required=false
META_APP_SECRET=

# GitLab feature flags' Unleash API URL (Deploy > Feature flags > Configure),
# e.g. https://gitlab.com/api/v4/feature_flags/unleash/<project id>.
# Optional: without it every flag is off (fault-injection-checkout included).
# @required=false @sensitive=false @type=url
GITLAB_FEATURE_FLAGS_URL=

# The Unleash instance ID from the same page.
# @required=false
GITLAB_FEATURE_FLAGS_INSTANCE_ID=

# The GitLab environment whose flag strategies apply (Unleash app name).
# @sensitive=false
GITLAB_FEATURE_FLAGS_ENVIRONMENT=production

# PostHog product analytics: the "wovain" project's public token (US cloud,
# project 687269), safe in client code. Cookieless, so no consent banner; the
# browser reaches PostHog through this site's /ingest rewrite. NEXT_PUBLIC_
# values are compiled into the client bundle, so the image build reads it
# (CI can override it with its own NEXT_PUBLIC_POSTHOG_KEY variable). Set it
# empty to turn analytics off.
# @required=false @sensitive=false
NEXT_PUBLIC_POSTHOG_KEY=phc_mME2j3q9bo7cE2Kn2tiZbQqZAfMmHR2HmmeWKzuMxZNo

# PostHog's ingestion host (EU projects: https://eu.i.posthog.com).
# @sensitive=false @type=url
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
