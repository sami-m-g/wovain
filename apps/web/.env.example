# wovain server keys for `bun run dev`. Copy to apps/web/.env and fill in;
# empty values count as unset. On Vercel, set them in the project's settings.
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_PIXEL_ID=
SERPAPI_KEY=
ETSY_API_KEY=
MARKER_API_TOKEN=
FAL_KEY=
# Optional: a second fal key with the Billing preset, so wovain can report what fal actually charged
FAL_BILLING_KEY=

# Guards /mcp until OAuth: 32+ random characters, e.g. `openssl rand -hex 32`.
# `bun run plugin:install` copies it into the installed plugin's headers.
WOVAIN_HTTP_TOKEN=

# Storage. Unset means a SQLite file and media files in apps/server/data.
# On Vercel the Neon and Blob integrations set these; for local work against
# Neon, use the dev branch's pooled URL, never production's.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
