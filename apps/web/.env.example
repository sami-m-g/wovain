# wovain server keys for `bun run dev`. Copy to apps/web/.env and fill in;
# empty values count as unset. On Vercel, set them in the project's settings.
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_PIXEL_ID=
SERPAPI_KEY=
ETSY_API_KEY=
MARKER_API_TOKEN=
FAL_KEY=
# Optional: a second fal key with the Billing preset, so wovain can report what fal actually charged
FAL_BILLING_KEY=

# Sign-in (Better Auth). The secret signs sessions and OAuth state: 32+
# random characters, e.g. `openssl rand -hex 32`. Google sign-in needs a web
# OAuth client whose redirect URI is <site>/api/auth/callback/google.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails allowed to sign in; empty lets nobody in. Everyone
# signed in acts through the Meta and fal keys above until step 4.
WOVAIN_ALLOWED_EMAILS=

# Storage. Unset means a SQLite file and media files in apps/server/data.
# On Vercel the Neon and Blob integrations set these; for local work against
# Neon, use the dev branch's pooled URL, never production's.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
