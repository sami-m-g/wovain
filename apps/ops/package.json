{
  "name": "@wovain/ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "env:generate": "varlock codegen",
    "heal-verify": "varlock codegen && node --import varlock/auto-load src/heal-verify.ts",
    "ops": "varlock codegen && node --import varlock/auto-load src/ops.ts",
    "sci-report": "varlock codegen && node --import varlock/auto-load src/sci-report.ts",
    "scout-collect": "varlock codegen && node --import varlock/auto-load src/scout-collect.ts",
    "submission-tag": "varlock codegen && node --import varlock/auto-load src/submission-tag.ts",
    "test": "vitest run",
    "traffic": "varlock codegen && node --import varlock/auto-load src/traffic.ts"
  },
  "dependencies": {
    "@gitbeaker/rest": "catalog:",
    "@google-cloud/logging": "catalog:",
    "@google-cloud/monitoring": "catalog:",
    "playwright": "^1.64.1",
    "varlock": "catalog:",
    "yaml": "^2.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@wovain/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
