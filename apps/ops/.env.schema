# @defaultRequired=false
# @defaultSensitive=false
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# What the ops jobs read from CI: GitLab's predefined variables plus the
# project's CI/CD variables (.gitlab-ci.yml lists them). Every item is optional
# here because the jobs need different ones (heal:verify has no token); the
# ones a job cannot run without are checked in src/context.ts.

# @required @type=url
CI_API_V4_URL=https://gitlab.com/api/v4
CI_PROJECT_ID=
CI_PROJECT_PATH=
CI_JOB_URL=
CI_MERGE_REQUEST_DIFF_BASE_SHA=
CI_MERGE_REQUEST_DESCRIPTION=

# @sensitive
GITLAB_TOKEN=
GCP_PROJECT_ID=

# The Duo service account names default to the hackathon group's; override them
# when GitLab names them differently (Automate > Triggers shows each one).
# @required
DUO_DEVELOPER_ACCOUNT=duo-developer-gitlab-ai-hackathon
# @required
DUO_HEAL_ACCOUNT=ai-wovain-heal-gitlab-ai-hackathon
# @required
DUO_REVIEW_ACCOUNT=duo-code-review-gitlab-ai-hackathon

# PostHog's query API for the scout: the app host, a personal API key with
# Query Read, and the project's id. Without the key or id, the scout skips
# PostHog.
# @required @type=url
POSTHOG_HOST=https://us.posthog.com
# @sensitive
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Comma-separated people whose agent::task label hands an issue to Duo. The
# token's owner is always trusted.
TRUSTED_USERS=

# Progressive delivery (src/canary.ts, docs/adr/0001-progressive-delivery.md):
# the Cloud Run service the canary runs on, how long the canary is watched
# and how often it's probed, and the release-guard flow's service account,
# which infra/duo.ts sets as a CI variable once the flow is enabled.
GCP_REGION=us-central1
CLOUD_RUN_SERVICE=wovain-web
# @type=number
CANARY_WINDOW_S=300
# @type=number
CANARY_INTERVAL_S=30
DUO_RELEASE_GUARD_ACCOUNT=
# The revision a ROLLBACK=1 pipeline moves traffic to; without it, the newest
# ready revision older than the one serving now.
ROLLBACK_TO=
CI_PIPELINE_URL=
CI_COMMIT_SHA=

# The live site the scout measures and the traffic script calls.
# @required @type=url
SITE_URL=https://wovain.com
# The docs site the synthetic checks call (src/smoke.ts).
# @required @type=url
DOCS_SITE_URL=https://docs.wovain.com

# PostHog Error Tracking, where every error goes (docs/flows.md, "One error
# sink"): the project's public token, a CI variable Pulumi sets
# (infra/index.ts), and the ingestion host. The ops jobs send platform errors
# and failed synthetic checks there; without the token they skip sending.
NEXT_PUBLIC_POSTHOG_KEY=
# @required @type=url
POSTHOG_INGEST_HOST=https://us.i.posthog.com
