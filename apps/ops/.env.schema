# @defaultRequired=false
# @defaultSensitive=false
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# What the ops jobs read from CI: GitLab's predefined variables plus the
# project's CI/CD variables (.gitlab-ci.yml lists them). Every item is optional
# here because the jobs need different ones (heal:verify has no token); the
# ones a job cannot run without are checked in src/context.ts.

# @required @type=url
CI_API_V4_URL=https://gitlab.com/api/v4
CI_PROJECT_ID=
CI_PROJECT_PATH=
CI_JOB_URL=
CI_MERGE_REQUEST_DIFF_BASE_SHA=
CI_MERGE_REQUEST_DESCRIPTION=

# @sensitive
GITLAB_TOKEN=
GCP_PROJECT_ID=

# The Duo service account names default to the hackathon group's; override them
# when GitLab names them differently (Automate > Triggers shows each one).
# @required
DUO_DEVELOPER_ACCOUNT=duo-developer-gitlab-ai-hackathon
# @required
DUO_HEAL_ACCOUNT=ai-wovain-heal-gitlab-ai-hackathon
# @required
DUO_REVIEW_ACCOUNT=duo-code-review-gitlab-ai-hackathon

# PostHog's query API for the scout: the app host, a personal API key with
# Query Read, and the project's id. Without the key or id, the scout skips
# PostHog.
# @required @type=url
POSTHOG_HOST=https://us.posthog.com
# @sensitive
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Comma-separated people whose agent::task label hands an issue to Duo. The
# token's owner is always trusted.
TRUSTED_USERS=

# The live site the scout measures and the traffic script calls.
# @required @type=url
SITE_URL=https://wovain.com
