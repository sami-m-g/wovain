{
  "permissions": {
    "deny": [
      "Edit(/.agents/**)",
      "Edit(/.claude/skills/**)",
      "Edit(/packages/ui/src/components/**)",
      "Edit(/packages/ui/src/hooks/**)",
      "Edit(/packages/ui/src/lib/**)",
      "Edit(/apps/fumadocs/src/components/ai/**)",
      "Edit(/apps/fumadocs/src/components/codeblock.tsx)",
      "Edit(/apps/fumadocs/src/components/tabs/**)",
      "Edit(/apps/fumadocs/src/components/ui/**)",
      "Edit(/apps/fumadocs/src/lib/cn.ts)",
      "Edit(/apps/fumadocs/src/lib/merge-refs.ts)",
      "Edit(/packages/db/src/schema/auth.ts)",
      "Edit(/packages/db/src/migrations/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm exec ultracite fix --hook"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "posthog@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "inngest@anthropic-plugin-directory": true,
    "playwright@claude-plugins-official": true,
    "mastra-skills@mastra-agent-skills": true,
    "humanizer@humanizer": true,
    "caveman@caveman": true,
    "google-cloud-developer@google-plugins": true,
    "cloud-sql-postgresql@google-plugins": true,
    "legal@knowledge-work-plugins": true,
    "product-management@knowledge-work-plugins": true,
    "finance@knowledge-work-plugins": true,
    "claude-ads@ai-marketing-hub-claude-ads": true
  },
  "extraKnownMarketplaces": {
    "mastra-agent-skills": {
      "source": {
        "source": "github",
        "repo": "mastra-ai/skills"
      }
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "google-plugins": {
      "source": {
        "source": "github",
        "repo": "google/skills"
      }
    },
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    }
  }
}
