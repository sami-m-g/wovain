{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bun scripts/set-version.ts ${nextRelease.version} && cd plugin && zip -qr ../wovain-plugin-${nextRelease.version}.zip ."
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "package.json", "plugin/plugin.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/gitlab",
      {
        "assets": [
          {
            "path": "wovain-plugin-*.zip",
            "label": "ChatGPT plugin (wovain-plugin-${nextRelease.version}.zip)",
            "target": "generic_package",
            "packageName": "wovain-plugin"
          }
        ]
      }
    ]
  ]
}
