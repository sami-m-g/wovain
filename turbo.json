{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vendor-types/**", ".next/**", "!.next/cache/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": ["dist/**", ".vendor-types/**"]
    },
    "test": {
      "outputs": ["junit.xml"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "db:push": {
      "cache": false,
      "interactive": true
    },
    "db:generate": {
      "cache": false,
      "interactive": true
    },
    "db:migrate": {
      "cache": false,
      "interactive": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "CI",
    "DATABASE_URL",
    "DOCS_CHAT_MAX_OUTPUT_TOKENS",
    "DOCS_CHAT_MODEL",
    "DOCS_CHAT_REASONING_EFFORT",
    "EMAIL_FROM",
    "FAL_IMAGE_MODEL",
    "META_APP_ID",
    "META_APP_SECRET",
    "NEBIUS_API_KEY",
    "NEBIUS_BASE_URL",
    "NEMOTRON_MODEL",
    "NODE_ENV",
    "POLAR_ACCESS_TOKEN",
    "POLAR_ENVIRONMENT",
    "POLAR_WEBHOOK_SECRET",
    "POSTHOG_HOST",
    "POSTHOG_KEY",
    "QLOO_API_KEY",
    "QLOO_API_URL",
    "RESEND_API_KEY",
    "TAVILY_API_KEY",
    "TOKEN_ENCRYPTION_KEY",
    "_VARLOCK_ENV_KEY"
  ],
  "globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
