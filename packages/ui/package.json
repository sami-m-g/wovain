{
  "name": "@wovain/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./src/lib/*.ts"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./src/components/*.tsx"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./src/hooks/*.ts"
    },
    "./postcss.config": "./postcss.config.mts"
  },
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc -b"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "^3.14.22",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "catalog:",
    "shadcn": "^4.21.0",
    "sonner": "catalog:",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@wovain/config": "workspace:*",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
