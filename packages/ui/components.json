{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/styles/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "aliases": {
    "components": "@wovain/ui/components",
    "utils": "@wovain/ui/lib/utils",
    "hooks": "@wovain/ui/hooks",
    "lib": "@wovain/ui/lib",
    "ui": "@wovain/ui/components"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@shadcn-studio": "https://shadcnstudio.com/r/{style}/{name}.json",
    "@reui": "https://reui.io/r/{style}/{name}.json",
    "@svgl": "https://svgl.app/r/{name}.json",
    "@magicui": "https://magicui.design/r/{name}"
  }
}
