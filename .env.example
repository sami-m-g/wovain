# wovain server keys. Copy to .env and fill in; empty values count as unset.
# The installed plugin reads this file through WOVAIN_ENV_FILE (set by `bun run plugin:install`).
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_PIXEL_ID=
SERPAPI_KEY=
ETSY_API_KEY=
MARKER_API_TOKEN=
FAL_KEY=

# HTTP fallback only (bun run start with WOVAIN_HTTP_PORT set):
# WOVAIN_HTTP_PORT=8787
# WOVAIN_HTTP_TOKEN=   # 32+ random characters, e.g. `openssl rand -hex 32`
# WOVAIN_HTTP_ALLOWED_HOSTS=   # your ngrok hostname
